# CoinMarketCap API key — REQUIRED for live scans and fixture capture.
# Get one at https://pro.coinmarketcap.com/ — never commit the real value.
CMC_API_KEY=

# Optional: path to an env file that already holds the key (e.g. ../verdex/.env.local)
# CMC_ENV_FILE=../verdex/.env.local

# Optional fallback key — used ONLY for documented failover, never to dodge 429/quota.
# CMC_FALLBACK_API_KEY=

# Collector budgets (defaults shown)
# MAKERHEAT_MAX_PAGES_QUICK=2
# MAKERHEAT_MAX_PAGES_DEEP=10
# MAKERHEAT_COLLECTOR_DEADLINE_MS=30000
# MAKERHEAT_CACHE_TTL_MS=45000
# MAKERHEAT_GLOBAL_CREDIT_BUDGET=200
# MAKERHEAT_PER_IP_PER_MIN=10

# Set to "1" to disable all live API paths (replay still works)
# MAKERHEAT_LIVE_OFF=0
